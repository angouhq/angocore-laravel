{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "angou/angocore-laravel",
    "description": "Laravel client SDK for AngoCore platform (payments + mail orchestration).",
    "type": "library",
    "version": "0.2.0",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/mail": "^13.0",
        "illuminate/support": "^13.0",
        "symfony/mailer": "^7.0|^8.0",
        "symfony/mime": "^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Angou\\Angocore\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Angou\\Angocore\\AngocoreServiceProvider"
            ],
            "aliases": {
                "Angopay": "Angou\\Angocore\\Facades\\Angopay",
                "Angomail": "Angou\\Angocore\\Facades\\Angomail"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
